# ============================================
# BASE DE DADOS
# ============================================
# Local (SQLite) - padrão para desenvolvimento
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) - descomentar para produção
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ============================================
# AUTENTICAÇÃO
# ============================================
# Chave secreta para JWT (mínimo 32 caracteres)
JWT_SECRET="your-super-secret-jwt-key-at-least-32-chars"

# ============================================
# STRIPE (Pagamentos)
# ============================================
# Chave secreta Stripe (sk_live_... ou sk_test_...)
STRIPE_SECRET_KEY="sk_test_placeholder"

# Webhook secret (whsec_...) - obtido do dashboard Stripe
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# ============================================
# MBWAY (Pagamentos)
# ============================================
# API Key MBWay
MBWAY_API_KEY=""

# Código de entidade MBWay
MBWAY_ENTITY_CODE=""

# Número de telefone entidade
MBWAY_ENTITY_PHONE=""

# URL da API (produção ou sandbox)
MBWAY_API_URL="https://api.mbway.pt/v1"

# Modo sandbox (true/false)
MBWAY_SANDBOX="true"

# Segredo para webhook MBWay
MBWAY_WEBHOOK_SECRET=""

# ============================================
# SMS (Notificações)
# ============================================
# Provider: twilio ou aws
SMS_PROVIDER="twilio"

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# AWS SNS
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SNS_TOPIC_ARN=""

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@example.com"
SMTP_PASS=""
SMTP_FROM="noreply@aldeias.pt"

# ============================================
# APLICAÇÃO
# ============================================
# URL pública da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# ============================================
# OPENROUTER (IA)
# ============================================
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# ============================================
# GITHUB
# ============================================
GITHUB_TOKEN=""
GITHUB_PAT=""

# ============================================
# NEON (PostgreSQL Cloud)
# ============================================
NEON_API_KEY=""

# ============================================
# SENTRY (Monitorização)
# ============================================
# DSN obtido no dashboard Sentry após criar projeto
NEXT_PUBLIC_SENTRY_DSN=""

# ============================================
# VERCEL (Produção)
# ============================================
# Adicionar no dashboard da Vercel como Secrets:
# - DATABASE_URL
# - JWT_SECRET
# - STRIPE_SECRET_KEY
# - STRIPE_WEBHOOK_SECRET
# - MBWAY_API_KEY
# - MBWAY_ENTITY_CODE
# - OPENROUTER_API_KEY
# - GITHUB_TOKEN
# - etc.

# ============================================
# OBJECT STORAGE (S3/R2) - OPCIONAL
# ============================================
# Para produção, configurar object storage para imagens
# Cloudflare R2 (recomendado)
# R2_BUCKET="aldeias-games"
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# R2_ACCESS_KEY=""
# R2_SECRET_KEY=""
# R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# Ou AWS S3
# S3_BUCKET="aldeias-games"
# S3_ENDPOINT="https://s3.eu-west-1.amazonaws.com"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_PUBLIC_URL="https://aldeias-games.s3.eu-west-1.amazonaws.com"
