generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  password                String
  nome                    String
  telefone                String?
  role                    UserRole                @default(user)
  emailVerificado         Boolean                 @default(false)
  notificacoesEmail       Boolean                 @default(true)
  ultimoLogin             DateTime?
  falhasLogin             Int                     @default(0)
  ultimaFalhaLogin        DateTime?
  deletedAt               DateTime?
  deletedReason           String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  aldeiaId                String?
  aldeiasPermitidas       String?
  saldo                   Float                   @default(0)
  comissaoPercentual      Float                   @default(10)
  comissaoAtiva           Boolean                 @default(true)
  comissaoTotal           Float                   @default(0)
  auditLogs               AuditLog[]
  entregasConfirmadas     EntregaSaldo[]          @relation("AdminEntregas")
  entregasVendidas        EntregaSaldo[]          @relation("VendedorEntregas")
  autorizacaoCarregamento PedidoCarregamento[]    @relation("AutorizacaoCarregamento")
  confirmacaoCarregamento PedidoCarregamento[]    @relation("ConfirmacaoCarregamento")
  pedidosCarregamento     PedidoCarregamento[]
  vendedorCarregamentos   PedidoCarregamento[]    @relation("VendedorCarregamentos")
  userAldeiaRoles         UserAldeiaRole[]
  userGlobalRoles         UserGlobalRole[]
  userPermissions         UserPermission[]
  alteracoes              AlteracaoParticipacao[]
  consentimentos          Consentimento[]
  direitosEsquecimento    DireitoEsquecimento[]
  gameAnalytics           GameAnalytics[]
  logsAcesso              LogAcesso[]
  notificacoes            Notificacao[]
  participacoes           Participacao[]
  participacoesVendidas   Participacao[]          @relation("vendedor")
  pushSubscriptions       PushSubscription[]
  transacoes              Transacao[]
  userBadges              UserBadge[]
  niveis                  UserLevel[]             @relation("userLevels")
  aldeia                  Aldeia?                 @relation("AldeiaUsers", fields: [aldeiaId], references: [id])
  vendas                  Venda[]
  aldeiasAdmin            Aldeia[]                @relation("AldeiaAdmins")
  aldeiasVendedor         Aldeia[]                @relation("AldeiaVendedores")
  badges                  Badge[]                 @relation("userBadges")
  @@index([email])
  @@index([role])
  @@index([aldeiaId])
  @@map("users")
}

model Badge {
  id           String      @id @default(cuid())
  nome         String
  descricao    String?
  imagemUrl    String?
  criterio     String
  pontos       Int         @default(10)
  raro         Boolean     @default(false)
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt
  userBadges   UserBadge[]
  users        User[]      @relation("userBadges")
  @@map("badges")
}

model UserBadge {
  id            String   @id @default(cuid())
  userId        String
  badgeId       String
  conquistadoEm DateTime @default(now())
  badge         Badge    @relation(fields: [badgeId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

model UserLevel {
  id                     String   @id @default(cuid())
  userId                 String
  nivel                  Int      @default(1)
  pontos                 Int      @default(0)
  pontosParaProximoNivel Int      @default(100)
  user                   User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@map("userLevels")
}

model Aldeia {
  id                     String   @id @default(cuid())
  nome                   String
  descricao              String?
  imagemUrl              String?
  nivel                  Int      @default(1)
  experiencia            Int      @default(0)
  pontos                 Int      @default(0)
  moedaInterna           Float    @default(0)
  membrosAtivos          Int      @default(0)
  dataCriacao            DateTime @default(now())
  adminId                String
  admin                  User     @relation(fields: [adminId], references: [id])
  membros                Membrao[] @relation("AldeiaMembers")
  eventos                Evento[] @relation("AldeiaEventos")
  jogos                  Jogo[]    @relation("AldeiaJogos")
  premios                Premio[]  @relation("AldeiaPremios")
  transacoes             Transacao[] @relation("AldeiaTransacoes")
  marketplaceListings    MarketplaceListing[] @relation("AldeiaMarketplace")
  @@map("aldeias")
}

model Membrao {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  aldeiaId  String
  aldeia    Aldeia   @relation(fields: [aldeiaId], references: [id])
  role      MembraoRole @default(membro)
  entrouEm  DateTime @default(now())
  saiuEm    DateTime?
  @@index([userId])
  @@index([aldeiaId])
  @@map("membraos")
}

model Evento {
  id          String   @id @default(cuid())
  titulo      String
  descricao   String?
  imagemUrl   String?
  dataInicio  DateTime
  dataFim     DateTime?
  estado      EstadoEvento @default(rascunho)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  aldeiaId    String
  aldeia      Aldeia   @relation(fields: [aldeiaId], references: [id])
  jogos       Jogo[]   @relation("EventoJogos")
  premios     Premio[] @relation("EventoPremios")
  transacoes  Transacao[] @relation("EventoTransacoes")
  @@index([aldeiaId])
  @@map("eventos")
}

model Jogo {
  id          String   @id @default(cuid())
  nome        String
  tipo        TipoJogo
  descricao   String?
  regras      String?
  imagemUrl   String?
  estado      EstadoJogo @default(rascunho)
  valorMinimo Float
  valorMaximo Float
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  aldeiaId    String
  aldeia      Aldeia   @relation(fields: [aldeiaId], references: [id])
  eventoId    String?
  evento      Evento?  @relation(fields: [eventoId], references: [id])
  premiacoes  Premio[] @relation("JogoPremios")
  transacoes  Transacao[] @relation("JogoTransacoes")
  @@index([aldeiaId])
  @@index([eventoId])
  @@map("jogos")
}

model Premio {
  id          String   @id @default(cuid())
  nome        String
  descricao   String?
  imagemUrl   String?
  tipo        TipoPremio
  valor       Float
  estoque     Int      @default(0)
  limitePorUser Int?   @default(null)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  aldeiaId    String
  aldeia      Aldeia   @relation(fields: [aldeiaId], references: [id])
  jogoId      String?
  jogo        Jogo?    @relation(fields: [jogoId], references: [id])
  transacoes  Transacao[] @relation("PremioTransacoes")
  @@index([aldeiaId])
  @@index([jogoId])
  @@map("premios")
}

model Transacao {
  id          String   @id @default(cuid())
  tipo        String
  valor       Float
  moeda       String   @default(SALDO)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  criadoEm    DateTime @default(now())
  descricao   String?
  @@index([userId])
  @@map("transacoes")
}

model MarketplaceListing {
  id        String   @id @default(cuid())
  title     String
  description String?
  price     Float
  currency  Currency @default(MOEDA_INTERNA)
  aldeiaId  String
  aldeia    Aldeia   @relation(fields: [aldeiaId], references: [id])
  jogoId    String?
  jogo      Jogo?    @relation(fields: [jogoId], references: [id])
  premioId  String?
  premio    Premio?  @relation(fields: [premioId], references: [id])
  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id])
  status    ListingStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?
  @@index([aldeiaId])
  @@index([status])
  @@index([sellerId])
}

model GameAnalytics {
  id          String   @id @default(cuid())
  jogoId      String
  jogo        Jogo     @relation(fields: [jogoId], references: [id])
  aldeiaId    String
  aldeia      Aldeia   @relation(fields: [aldeiaId], references: [id])
  totalVendas Int      @default(0)
  totalReceita Float   @default(0)
  totalParticipantes Int @default(0)
  mediaNota   Float    @default(0)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  @@index([jogoId])
  @@index([aldeiaId])
  @@map("gameAnalytics")
}

model LogAcesso {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  rota        String
  metodo      String
  statusCode  Int
  ip          String
  userAgent   String?
  criadoEm    DateTime @default(now())
  @@index([userId])
  @@map("logAcesso")
}

model Notificacao {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tipo        TipoNotificacao
  titulo      String
  corpo       String?
  lida        Boolean  @default(false)
  criadoEm    DateTime @default(now())
  @@index([userId])
  @@map("notificacoes")
}

model Participacao {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  jogoId      String
  jogo        Jogo     @relation(fields: [jogoId], references: [id])
  quantidade  Int
  valorTotal  Float
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  status      EstadoParticipacao @default(pendente)
  @@index([userId])
  @@index([jogoId])
  @@map("participacoes")
}

model Venda {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  jogoId      String
  jogo        Jogo     @relation(fields: [jogoId], references: [id])
  quantidade  Int
  valorTotal  Float
  criadoEm    DateTime @default(now())
  status      EstadoVenda @default(pendente)
  @@index([userId])
  @@index([jogoId])
  @@map("vendas")
}

model EntregaSaldo {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  valor       Float
  status      EstadoEntrega @default(solicitado)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  @@index([userId])
  @@map("entregaSaldo")
}

model PedidoCarregamento {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  valor       Float
  status      EstadoPedido @default(pendente)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  @@index([userId])
  @@map("pedidoCarregamento")
}

model AutorizacaoCarregamento {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  valor       Float
  criadoEm    DateTime @default(now())
  @@index([userId])
  @@map("autorizacaoCarregamento")
}

model ConfirmacaoCarregamento {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  valor       Float
  criadoEm    DateTime @default(now())
  @@index([userId])
  @@map("confirmacaoCarregamento")
}

model RolePermission {
  id          String   @id @default(cuid())
  role        RoleName
  permission  PermissionKey
  @@index([role])
  @@index([permission])
  @@map("rolePermission")
}

model UserAldeiaRole {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  aldeiaId    String
  aldeia      Aldeia   @relation(fields: [aldeiaId], references: [id])
  role        MembraoRole
  atribuidoEm DateTime @default(now())
  @@index([userId])
  @@index([aldeiaId])
  @@map("userAldeiaRole")
}

model UserGlobalRole {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  role        UserRole
  atribuidoEm DateTime @default(now())
  @@index([userId])
  @@map("userGlobalRole")
}

model UserPermission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  permission  PermissionKey
  atribuidoEm DateTime @default(now())
  @@index([userId])
  @@map("userPermission")
}

enum UserRole {
  admin
  user
}

enum MembraoRole {
  lider
  moderador
  membro
}

enum TipoJogo {
  poio_da_vaca
  rifa
  tombola
  raspadinha
}

enum EstadoJogo {
  rascunho
  aberto
  pausado
  fechado
  finalizado
}

enum EstadoEvento {
  rascunho
  ativo
  pausado
  finalizado
  cancelado
}

enum TipoPremio {
  dinheiro
  fisico
  experiencia
}

enum MetodoPagamento {
  mbway
  dinheiro
  stripe
  transferencia
  saldo
}

enum Recorrencia {
  semanal
  quinzenal
  mensal
}

enum EstadoPagamento {
  pendente
  processando
  concluido
  falhou
  reembolsado
}

enum TipoNotificacao {
  sistema
  pagamento
  sorteio
  premio
  campanha
  alerta
}

enum EstadoParticipacao {
  pendente
  confirmado
  cancelado
}

enum EstadoVenda {
  pendente
  confirmado
  cancelado
}

enum EstadoEntrega {
  solicitado
  confirmado
  cancelado
  concluido
}

enum EstadoPedido {
  pendente
  confirmado
  cancelado
  expirado
  aguardar_autorizacao
}

enum Currency {
  SALDO
  MOEDA_INTERNA
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
}