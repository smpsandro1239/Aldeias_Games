generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(cuid())
  email                 String                  @unique
  password              String
  nome                  String
  telefone              String?
  role                  UserRole                @default(user)
  emailVerificado       Boolean                 @default(false)
  notificacoesEmail     Boolean                 @default(true)
  ultimoLogin           DateTime?
  falhasLogin           Int                     @default(0)
  ultimaFalhaLogin      DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  aldeiaId              String?
  aldeiasPermitidas     String?
  saldo                 Float                   @default(0)
  alteracoes            AlteracaoParticipacao[]
  logsAcesso            LogAcesso[]
  notificacoes          Notificacao[]
  participacoes         Participacao[]
  participacoesVendidas Participacao[]          @relation("vendedor")
  pushSubscriptions     PushSubscription[]
  transacoes            Transacao[]
  aldeia                Aldeia?                 @relation("AldeiaUsers", fields: [aldeiaId], references: [id])
  vendas                Venda[]
  aldeiasAdmin          Aldeia[]                @relation("AldeiaAdmins")
  aldeiasVendedor       Aldeia[]                @relation("AldeiaVendedores")

  @@index([email])
  @@index([role])
  @@index([aldeiaId])
  @@map("users")
}

model Transacao {
  id              String        @id @default(cuid())
  valor           Float
  tipo            TipoTransacao
  descricao       String?
  referencia      String?
  metodoPagamento String?
  estado          String?
  dadosAdicionais Json?
  createdAt       DateTime      @default(now())
  userId          String
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tipo])
  @@index([createdAt])
  @@map("transacoes")
}

model Comissao {
  id         String   @id @default(cuid())
  vendedorId String
  percentual Float    @default(5)
  metaVendas Float?
  bonusMeta  Float?
  aldeiaId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vendedorId])
  @@index([aldeiaId])
  @@map("comissoes")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_resets")
}

model TwoFactorAuth {
  id        String   @id @default(cuid())
  userId    String   @unique
  secret    String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("two_factor_auths")
}

model LogAcesso {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  sucesso   Boolean
  ip        String
  userAgent String
  motivo    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("logs_acesso")
}

model Plano {
  id               String   @id @default(cuid())
  nome             String
  descricao        String?
  precoMensal      Float
  maxEventos       Int      @default(10)
  maxJogos         Int      @default(50)
  maxParticipacoes Int      @default(1000)
  maxVendedores    Int      @default(5)
  recursos         String?
  stripePriceId    String?
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  aldeias          Aldeia[]

  @@map("planos")
}

model Aldeia {
  id                     String          @id @default(cuid())
  nome                   String
  slug                   String          @unique
  tipoOrganizacao        TipoOrganizacao @default(aldeia)
  descricao              String?
  logoUrl                String?
  logoBase64             String?
  permitirStripe         Boolean         @default(false)
  permitirMBWay          Boolean         @default(false)
  iban                   String?
  nomeTitularConta       String?
  avisoPagamentosEnviado Boolean         @default(false)
  nomeEscola             String?
  codigoEscola           String?
  nivelEnsino            NivelEnsino?
  responsavel            String?
  telefone               String?
  email                  String?
  morada                 String?
  codigoPostal           String?
  localidade             String?
  autorizacaoCM          Boolean         @default(false)
  numeroAlvara           String?
  documentosVerificados  Boolean         @default(false)
  ativo                  Boolean         @default(true)
  verificado             Boolean         @default(false)
  dataVerificacao        DateTime?
  planoId                String?
  dataInicioPlano        DateTime?
  dataFimPlano           DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  plano                  Plano?          @relation(fields: [planoId], references: [id])
  eventos                Evento[]
  premios                Premio[]
  users                  User[]          @relation("AldeiaUsers")
  admins                 User[]          @relation("AldeiaAdmins")
  vendedores             User[]          @relation("AldeiaVendedores")
  jogos                  Jogo[]

  @@index([slug])
  @@index([tipoOrganizacao])
  @@index([verificado])
  @@map("aldeias")
}

model Evento {
  id                  String       @id @default(cuid())
  nome                String
  slug                String       @unique
  descricao           String?
  imagemUrl           String?
  imagemBase64        String?
  dataInicio          DateTime
  dataFim             DateTime
  objectivoAngariacao Float?
  estado              EstadoEvento @default(rascunho)
  publico             Boolean      @default(false)
  totalAngariado      Float        @default(0)
  totalParticipacoes  Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  aldeiaId            String
  aldeia              Aldeia       @relation(fields: [aldeiaId], references: [id])
  jogos               Jogo[]

  @@index([aldeiaId])
  @@index([estado])
  @@index([publico])
  @@index([dataInicio])
  @@map("eventos")
}

model Jogo {
  id                      String         @id @default(cuid())
  nome                    String
  tipo                    TipoJogo
  descricao               String?
  configuracao            String
  dimensoesCampo          String?
  preco                   Float
  stockInicial            Int
  stockAtual              Int
  limitePorUsuario        Int            @default(10)
  custoQuadrado           Float?
  valorPremioVaca         Float?
  custoPremioDinheiro     Float?
  valorCompraVaca         Float?
  valorMercadoVaca        Float?
  rentabilidadePercentual Float?
  lucroMinimoPercent      Float?
  custoMedioPrevisto      Float?
  receitaEsperada         Float?
  lucroLiquidoPrevisto    Float?
  percentagemTotalPremios Float?
  hashVerificacao         String?
  estado                  EstadoJogo     @default(aberto)
  dataAbertura            DateTime?
  dataFecho               DateTime?
  totalParticipacoes      Int            @default(0)
  totalAngariado          Float          @default(0)
  sorteado                Boolean        @default(false)
  dataSorteio             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  eventoId                String
  aldeiaId                String?
  premioId                String?
  modoSorteio             String         @default("app")
  detalhesSorteioExterno  String?
  apostas                 Aposta[]
  evento                  Evento         @relation(fields: [eventoId], references: [id])
  aldeia                  Aldeia?        @relation(fields: [aldeiaId], references: [id])
  participacoes           Participacao[]
  premios                 Premio[]       @relation("JogoPremios")
  sorteios                Sorteio[]

  @@index([eventoId])
  @@index([tipo])
  @@index([estado])
  @@index([premioId])
  @@map("jogos")
}

model Aposta {
  id              String   @id @default(cuid())
  jogoId          String
  numeros         String
  jogadorNome     String
  jogadorTelefone String?
  jogadorEmail    String?
  vendedorId      String?
  pago            Boolean  @default(false)
  createdAt       DateTime @default(now())
  jogo            Jogo     @relation(fields: [jogoId], references: [id])

  @@index([jogoId])
  @@map("apostas")
}

model Premio {
  id                       String   @id @default(cuid())
  nome                     String
  descricao                String?
  imagemUrl                String?
  valorDinheiroAlternative Float?
  percentagem              Float?
  ordem                    Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  aldeiaId                 String
  jogoId                   String?
  aldeia                   Aldeia   @relation(fields: [aldeiaId], references: [id])
  jogo                     Jogo?    @relation("JogoPremios", fields: [jogoId], references: [id])

  @@index([aldeiaId])
  @@map("premios")
}

model Participacao {
  id                  String                  @id @default(cuid())
  dadosParticipacao   String
  valorPago           Float
  metodoPagamento     MetodoPagamento
  estadoPagamento     EstadoPagamento         @default(pendente)
  referenciaPagamento String?
  dataPagamento       DateTime?
  seedRaspe           String?
  hashRaspe           String?
  resultadoRaspe      String?
  revelado            Boolean                 @default(false)
  dataRevelacao       DateTime?
  hashParticipacao    String?
  dadosVerificacao    String?
  vendedorId          String?
  nomeCliente         String?
  telefoneCliente     String?
  emailCliente        String?
  ganhador            Boolean                 @default(false)
  premioEntregue      Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  jogoId              String
  userId              String?
  alteracoes          AlteracaoParticipacao[]
  jogo                Jogo                    @relation(fields: [jogoId], references: [id])
  user                User?                   @relation(fields: [userId], references: [id])
  vendedor            User?                   @relation("vendedor", fields: [vendedorId], references: [id])

  @@index([jogoId])
  @@index([userId])
  @@index([estadoPagamento])
  @@index([createdAt])
  @@map("participacoes")
}

model AlteracaoParticipacao {
  id              String        @id @default(cuid())
  tipoAlteracao   String
  dadosAnteriores String?
  motivo          String?
  ip              String
  createdAt       DateTime      @default(now())
  participacaoId  String?
  userId          String
  participacao    Participacao? @relation(fields: [participacaoId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([participacaoId])
  @@index([userId])
  @@map("alteracoes_participacao")
}

model Sorteio {
  id          String            @id @default(cuid())
  seed        String
  hash        String
  resultado   String
  observacoes String?
  createdAt   DateTime          @default(now())
  jogoId      String
  jogo        Jogo              @relation(fields: [jogoId], references: [id])
  vencedores  VencedorSorteio[]

  @@index([jogoId])
  @@index([createdAt])
  @@map("sorteios")
}

model VencedorSorteio {
  id             String   @id @default(cuid())
  posicao        Int
  dadosVencedor  String
  premioEntregue Boolean  @default(false)
  createdAt      DateTime @default(now())
  sorteioId      String
  sorteio        Sorteio  @relation(fields: [sorteioId], references: [id])

  @@index([sorteioId])
  @@map("vencedores_sorteio")
}

model Notificacao {
  id              String          @id @default(cuid())
  tipo            TipoNotificacao
  titulo          String
  mensagem        String
  dados           String?
  dadosAdicionais Json?
  lida            Boolean         @default(false)
  estado          String?
  createdAt       DateTime        @default(now())
  userId          String
  user            User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([lida])
  @@index([createdAt])
  @@map("notificacoes")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_subscriptions")
}

model Venda {
  id              String          @id @default(cuid())
  valor           Float
  comissao        Float           @default(0)
  metodoPagamento MetodoPagamento
  dadosCliente    String?
  createdAt       DateTime        @default(now())
  vendedorId      String
  vendedor        User            @relation(fields: [vendedorId], references: [id])

  @@index([vendedorId])
  @@index([createdAt])
  @@map("vendas")
}

enum TipoTransacao {
  deposito
  levantamento
  cashback
  pagamento_jogo
  premio_dinheiro
  comissao
  bonus_meta
  carregamento_saldo
}

enum UserRole {
  super_admin
  aldeia_admin
  vendedor
  user
}

enum TipoOrganizacao {
  aldeia
  escola
  associacao_pais
  clube
}

enum NivelEnsino {
  pre_escolar
  primeiro_ciclo
  segundo_ciclo
  terceiro_ciclo
  secundario
  superior
}

enum EstadoEvento {
  rascunho
  ativo
  pausado
  finalizado
  cancelado
}

enum TipoJogo {
  poio_da_vaca
  rifa
  tombola
  raspadinha
}

enum EstadoJogo {
  rascunho
  aberto
  pausado
  fechado
  finalizado
}

enum TipoPremio {
  dinheiro
  fisico
  experiencia
}

enum MetodoPagamento {
  mbway
  dinheiro
  stripe
  transferencia
  saldo
}

enum EstadoPagamento {
  pendente
  processando
  concluido
  falhou
  reembolsado
}

enum TipoNotificacao {
  sistema
  pagamento
  sorteio
  premio
  campanha
  alerta
}
