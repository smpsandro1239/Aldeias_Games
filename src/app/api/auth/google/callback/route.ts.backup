import { NextRequest, NextResponse } from 'next/server';
import { generateToken, setAuthCookie } from '@/lib/auth';
import { prisma } from '@/lib/db';
import { logger } from '@/lib/logger';

// Estado temporário para prevenir CSRF (em produção, use armazenamento seguro)
const STATE_COOKIE_NAME = 'google_oauth_state';

export async function GET(request: NextRequest) {
  try {
    const { searchParams } = new URL(request.url);
    const code = searchParams.get('code');
    const state = searchParams.get('state');
    const error = searchParams.get('error');

    // Tratar erros do Google
    if (error) {
      logger.error('Google OAuth error', { module: 'auth', error });
      return NextResponse.redirect(
        new URL('/?error=google_oauth_failed', request.url)
      );
    }

    // Verificar state para prevenir CSRF
    const storedState = request.cookies.get(STATE_COOKIE_NAME)?.value;
    if (!state || state !== storedState) {
      logger.warn('Invalid OAuth state', { module: 'auth', state, storedState });
      return NextResponse.redirect(
        new URL('/?error=invalid_state', request.url)
      );
    }

    if (!code) {
      return NextResponse.redirect(
        new URL('/?error=missing_code', request.url)
      );
    }

    // Trocar código de autorização por tokens
    const tokenResponse = await fetch('https://oauth2.googleapis.com/token', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: new URLSearchParams({
        client_id: process.env.GOOGLE_CLIENT_ID!,
        client_secret: process.env.GOOGLE_CLIENT_SECRET!,
        code,
        redirect_uri: process.env.GOOGLE_REDIRECT_URI!,
        grant_type: 'authorization_code',
      }),
    });

    if (!tokenResponse.ok) {
      logger.error('Failed to exchange Google auth code', {
        module: 'auth',
        status: tokenResponse.status,
        body: await tokenResponse.text(),
      });
      return NextResponse.redirect(
        new URL('/?error=token_exchange_failed', request.url)
      );
    }

    const tokenData = await tokenResponse.json();
    const { access_token, id_token } = tokenData;

    // Obter informações do usuário do Google
    const userInfoResponse = await fetch(
      'https://www.googleapis.com/oauth2/v2/userinfo',
      {
        headers: {
          Authorization: `Bearer ${access_token}`,
        },
      }
    );

    if (!userInfoResponse.ok) {
      logger.error('Failed to fetch Google user info', {
        module: 'auth',
        status: userInfoResponse.status,
      });
      return NextResponse.redirect(
        new URL('/?error=user_info_failed', request.url)
      );
    }

    const googleUser = await userInfoResponse.json();
    const { email, name, picture, verified_email, id: googleId } = googleUser;

    if (!email || !verified_email) {
      return NextResponse.redirect(
        new URL('/?error=unverified_email', request.url)
      );
    }

    // Procurar usuário existente pelo email
    let user = await prisma.user.findUnique({
      where: { email: email.toLowerCase() },
      include: { aldeia: true },
    });

    // Se não existir, criar novo usuário
    if (!user) {
      // Gerar senha aleatória (não usada para login, mas necessária para o schema)
      const randomPassword = Math.random().toString(36).slice(-12);
      const passwordHash = await require('bcryptjs').hash(randomPassword, 10);

      user = await prisma.user.create({
        data: {
          email: email.toLowerCase(),
          password: passwordHash,
          nome: name || email.split('@')[0],
          telefone: '+351 900 000 000', // Placeholder
          role: 'user', // Papel padrão para usuários do Google
          emailVerificado: true, // Emails do Google são pré-verificados
          saldo: 0,
          fotoUrl: picture,
          googleId,
        },
        include: { aldeia: true },
      });

      logger.info('New user created via Google OAuth', {
        module: 'auth',
        userId: user.id,
        email: user.email,
      });
    } else {
      // Usuário existente - atualizar dados do Google se necessário
      await prisma.user.update({
        where: { id: user.id },
        data: {
          nome: name || user.nome,
          fotoUrl: picture,
          googleId: googleId || user.googleId, // Vincular se ainda não estiver
        },
      });

      logger.info('Existing user logged in via Google OAuth', {
        module: 'auth',
        userId: user.id,
        email: user.email,
      });
    }

    // Gerar token JWT para o usuário
    const token = await generateToken({
      userId: user.id,
      email: user.email,
      role: user.role,
      aldeiaId: user.aldeiaId || undefined,
    });

    // Criar resposta de redirecionamento com cookie
    const response = NextResponse.redirect(
      new URL('/', request.url) // Redirecionar para home após login
    );

    // Definir cookie httpOnly seguro
    setAuthCookie(response, token);

    // Limpar cookie de state
    response.cookies.set({
      name: STATE_COOKIE_NAME,
      value: '',
      httpOnly: true,
      secure: process.env.NODE_ENV === 'production',
      sameSite: 'lax',
      maxAge: 0,
      path: '/',
    });

    logger.info('Google OAuth login successful', {
      module: 'auth',
      userId: user.id,
      email: user.email,
      role: user.role,
    });

    return response;
  } catch (error) {
    logger.error('Google OAuth error', { module: 'auth', error });
    return NextResponse.redirect(
      new URL('/?error=unexpected_error', request.url)
    );
  }
}
